# Copie este arquivo para infra/.env (gitignored) e preencha com valores reais.
# Usado pelo docker-compose.yml para o setup inicial do InfluxDB e do Grafana.
# Nunca commitar infra/.env.

INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=troque-esta-senha
INFLUXDB_INIT_ORG=fsae
INFLUXDB_INIT_BUCKET=telemetria
INFLUXDB_INIT_ADMIN_TOKEN=troque-este-token

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-tambem

# Senha do usuário MQTT telemetria_reader que o Grafana usa no painel ao
# vivo. TEM que ser a mesma senha cadastrada no passwd do Mosquitto:
#   ./mosquitto/generate_passwd.sh telemetria_reader
MQTT_READER_PASSWORD=troque-pela-senha-do-telemetria-reader
